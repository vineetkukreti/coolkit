# ============================================================
# coolkit Environment Variables
# Copy this file to config/.env and fill in your values:
#   cp config/env.example config/.env
# ============================================================

# --- AI / LLM ---
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Email (Gmail SMTP) ---
# Generate an App Password: Google Account > Security > 2FA > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=your.email@gmail.com
FROM_NAME=Your Name

# --- Email Reply Detection (optional) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Email Enrichment (optional) ---
# Get your key from https://hunter.io
HUNTER_API_KEY=

# --- Voice / TTS (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
